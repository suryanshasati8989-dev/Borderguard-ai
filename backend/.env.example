# BorderGuard AI — copy to .env and set values locally.
# Never commit real credentials. These are bootstrap defaults for local/hackathon use only.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_HOURS=12

# SQLite (default) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://borderguard:borderguard@localhost:5432/borderguard
DATABASE_URL=sqlite:///borderguard.db

# First-run bootstrap accounts (change immediately; not production credentials)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin_123
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=ChangeMe_Operator_123

# Detection: auto | yolo | opencv | simulation
DETECTION_MODE=auto
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.45

# Data retention (days). Events/alerts older than this are purged.
RETENTION_DAYS=30

# Evidence stills
EVIDENCE_DIR=../demo/evidence

# Demo video directory
DEMO_VIDEO_DIR=../demo/videos

# Optional FFmpeg binary (leave empty to use PATH)
FFMPEG_PATH=

# Bind
HOST=0.0.0.0
PORT=5000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
